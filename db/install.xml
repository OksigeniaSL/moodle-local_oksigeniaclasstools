<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/oksigeniaclasstools/db" VERSION="20261012" COMMENT="XMLDB file for local_oksigeniaclasstools"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_oksigeniaclasstools_picks" COMMENT="Each time a student is picked on the board (fair picking and participation)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The student who was picked"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The teacher who picked (0 if deleted)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid-timecreated" UNIQUE="false" FIELDS="courseid, timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oksigeniaclasstools_state" COMMENT="What each teacher keeps of each tool in each course (scoreboard, roscos…), to go on from any computer">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The teacher"/>
        <FIELD NAME="tool" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="data" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid-userid-tool" UNIQUE="true" FIELDS="courseid, userid, tool"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oksigeniaclasstools_live" COMMENT="Live sessions: students answer from their devices (votes, team buzzers) or the teacher's phone works as a remote">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The teacher who opened it"/>
        <FIELD NAME="code" TYPE="char" LENGTH="8" NOTNULL="true" SEQUENCE="false" COMMENT="What the devices type or scan to join"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false" COMMENT="vote, buzz or remote"/>
        <FIELD NAME="identity" TYPE="char" LENGTH="8" NOTNULL="true" SEQUENCE="false" COMMENT="anon (with the code) or moodle (with their account)"/>
        <FIELD NAME="state" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON: open, options, teams, kicked devices, remote commands"/>
        <FIELD NAME="round" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last sign of the teacher's board"/>
        <FIELD NAME="timeend" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="code" UNIQUE="false" FIELDS="code"/>
        <INDEX NAME="timeend-timemodified" UNIQUE="false" FIELDS="timeend, timemodified"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oksigeniaclasstools_livein" COMMENT="Who is in a live session (round 0) and what each device answered in each round">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="liveid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="round" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="0: joined; then one row per answer"/>
        <FIELD NAME="device" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Random token of the device (or u + user id)"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Only when they join with their account"/>
        <FIELD NAME="team" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="answer" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="A vote, a press, a word or two, or a sentence of an exit ticket"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="15" NOTNULL="true" SEQUENCE="false" COMMENT="Milliseconds, for who pressed first"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="liveid" TYPE="foreign" FIELDS="liveid" REFTABLE="local_oksigeniaclasstools_live" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="liveid-round-device" UNIQUE="true" FIELDS="liveid, round, device"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oksigeniaclasstools_remote" COMMENT="The fixed remote of each teacher: the key of its address, whether it is on, and what is going on (open boards, orders)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The teacher"/>
        <FIELD NAME="token" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="The key in the address of the remote"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="state" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON: the open boards, the orders and when the phone was last seen"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="token" UNIQUE="true" FIELDS="token"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oksigeniaclasstools_uses" COMMENT="Real uses of the tools with a class, for the teacher's stickers: one per sticker, course and day">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The teacher"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="cromo" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="The sticker (one per tool)"/>
        <FIELD NAME="day" TYPE="int" LENGTH="8" NOTNULL="true" SEQUENCE="false" COMMENT="YYYYMMDD in the teacher's time zone"/>
        <FIELD NAME="week" TYPE="int" LENGTH="6" NOTNULL="true" SEQUENCE="false" COMMENT="ISO year and week, YYYYWW"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid-cromo-courseid-day" UNIQUE="true" FIELDS="userid, cromo, courseid, day"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oksigeniaclasstools_learnt" COMMENT="The stickers a teacher has learned: the «Now you» of their guided help, done on the practice board">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The teacher"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Where the help was opened"/>
        <FIELD NAME="cromo" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="The sticker (one per tool)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid-cromo" UNIQUE="true" FIELDS="userid, cromo"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oksigeniaclasstools_tally" COMMENT="How much each tool, game and material of the board is used, per course and day, by teachers and by students">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="day" TYPE="int" LENGTH="8" NOTNULL="true" SEQUENCE="false" COMMENT="YYYYMMDD in the time zone of the one who used it"/>
        <FIELD NAME="who" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="teacher or student, as the board opened"/>
        <FIELD NAME="tool" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="The tab, or a game or material inside it: juegos/rosco"/>
        <FIELD NAME="opens" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Times it was chosen"/>
        <FIELD NAME="seconds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Seconds on screen while in use"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid-day-who-tool" UNIQUE="true" FIELDS="courseid, day, who, tool"/>
        <INDEX NAME="day" UNIQUE="false" FIELDS="day"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_oksigeniaclasstools_shared" COMMENT="Class lists, letter wheels and locks a teacher shares with the whole site, for every teacher to use">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="kind" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="lists, roscos or locks"/>
        <FIELD NAME="name" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="data" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON: the item as the board keeps it"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The teacher who shared it"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="kind-name" UNIQUE="false" FIELDS="kind, name"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
