{{!
    @template local_oksigeniaclasstools/choose

    «Which class?»: the look of the board, not of Moodle, and everything on one screen. A greeting with the date, the
    courses in one compact grid (picture, category, name and some faces of the class), filters by category and stage
    and a search, and a panel at the side: carry on with the last class, the board without a course and the fixed
    remote (with its QR when it is on), the teacher's stickers and the teachers' room.

    Context variables required for this template:
    * hello - the greeting, with the teacher's first name
    * date - today, as the teacher's calendar says it
    * search - whether to show the search box
    * categories - the categories to filter by (id, name), when there are more than one
    * stages - when the courses are of more than one stage, each stage (mode, name)
    * courses - url, name, category, categoryid, image, mode, modename (only when the mode was chosen), students, faces
    * continue - the last class used (url, name, image), if any
    * standalone - the address of the board without a course
    * remote - the fixed remote: on, url
    * album - the teacher's stickers, when they are on: got (how many, as text) and json (what the page draws)
    * sala - the teachers' room, when it is on: joined, count, span, others (texts), json (what the page draws), ajax
      (Moodle's AJAX service), sesskey

    Example context (json):
    {
        "hello": "Good afternoon, Ana",
        "date": "Monday, 12 October 2026",
        "search": true,
        "categories": [{"id": 1, "name": "Primary"}, {"id": 2, "name": "Secondary"}],
        "stages": [{"mode": "primary", "name": "Primary"}, {"mode": "secondary", "name": "Secondary"}],
        "courses": [
            {
                "url": "https://example.org/local/oksigeniaclasstools/index.php?id=2",
                "name": "Science, Year 5",
                "category": "Primary",
                "categoryid": 1,
                "image": "https://example.org/pluginfile.php/1/course/overviewfiles/science.jpg",
                "mode": "primary",
                "modename": "Primary",
                "students": "24 students",
                "faces": [{"src": "https://example.org/user/pix.php/3/f2.jpg"}, {"initials": "LM"}]
            }
        ],
        "continue": {"url": "https://example.org/local/oksigeniaclasstools/index.php?id=2", "name": "Science, Year 5",
            "image": "https://example.org/pluginfile.php/1/course/overviewfiles/science.jpg"},
        "standalone": "https://example.org/local/oksigeniaclasstools/index.php?standalone=1",
        "remote": {"on": true, "url": "https://example.org/local/oksigeniaclasstools/mando.php?k=abc"},
        "album": {"got": "2 of 18 stickers", "json": "{}"},
        "sala": {"joined": false, "count": "3 in the room", "span": "It counts the last 12 weeks.",
            "others": "And 9 more colleagues play with their classes.", "json": "{}",
            "ajax": "https://example.org/lib/ajax/service.php", "sesskey": "abc"}
    }
}}
<div class="ct-ch">
    <div class="ct-ch-franja" aria-hidden="true"></div>
    <header class="ct-ch-cab">
        <div>
            <p class="ct-ch-hola">{{hello}}</p>
            <h2 class="ct-ch-titulo">{{#str}} choose, local_oksigeniaclasstools {{/str}}</h2>
            <p class="ct-ch-fecha">{{date}} · {{#str}} choose_desc, local_oksigeniaclasstools {{/str}}</p>
        </div>
        <div class="ct-ch-herr">
            {{#categories.0}}
            <label class="ct-ch-categoria">
                <span class="sr-only visually-hidden">{{#str}} choose_category, local_oksigeniaclasstools {{/str}}</span>
                <select id="ct-ch-categoria">
                    <option value="">{{#str}} choose_all_categories, local_oksigeniaclasstools {{/str}}</option>
                    {{#categories}}<option value="{{id}}">{{name}}</option>{{/categories}}
                </select>
            </label>
            {{/categories.0}}
            {{#search}}
            <label class="ct-ch-buscar">
                <span class="sr-only visually-hidden">{{#str}} choose_search, local_oksigeniaclasstools {{/str}}</span>
                <input type="search" id="ct-ch-buscar" placeholder="{{#str}} choose_search, local_oksigeniaclasstools {{/str}}" autocomplete="off">
            </label>
            {{/search}}
        </div>
    </header>
    {{#stages.0}}
    <div class="ct-ch-filtros" role="group" aria-label="{{#str}} choose_filter, local_oksigeniaclasstools {{/str}}">
        <button type="button" aria-pressed="true" data-mode="">{{#str}} choose_all, local_oksigeniaclasstools {{/str}}</button>
        {{#stages}}<button type="button" aria-pressed="false" data-mode="{{mode}}" class="ct-mode-{{mode}}">{{name}}</button>{{/stages}}
    </div>
    {{/stages.0}}
    <div class="ct-ch-cuerpo">
        <div class="ct-ch-rejilla" data-ajax="{{ajax}}" data-sesskey="{{sesskey}}">
            {{#courses}}
            <div class="ct-ch-sitio" data-id="{{id}}" data-name="{{name}}" data-mode="{{mode}}" data-cat="{{categoryid}}" data-oculto="{{#hidden}}1{{/hidden}}{{^hidden}}0{{/hidden}}"{{#hidden}} hidden{{/hidden}}>
            <a class="ct-ch-curso ct-mode-{{mode}}" href="{{url}}">
                <span class="ct-ch-img"><img src="{{image}}" alt="" loading="lazy">{{#modename}}<span class="ct-ch-modo">{{modename}}</span>{{/modename}}</span>
                <span class="ct-ch-info">
                    <span class="ct-ch-cat">{{category}}</span>
                    <span class="ct-ch-nombre">{{name}}</span>
                    <span class="ct-ch-clase">
                        <span class="ct-ch-caras" aria-hidden="true">{{#faces}}{{#src}}<img src="{{src}}" alt="" loading="lazy">{{/src}}{{#initials}}<span>{{initials}}</span>{{/initials}}{{/faces}}</span>
                        <span class="ct-ch-num">{{students}}</span>
                    </span>
                </span>
            </a>
            <button type="button" class="ct-ch-ocultar" aria-label="{{#str}} choose_hide, local_oksigeniaclasstools {{/str}}: {{name}}" title="{{#str}} choose_hide, local_oksigeniaclasstools {{/str}}" data-hide="{{#str}} choose_hide, local_oksigeniaclasstools {{/str}}" data-show="{{#str}} choose_unhide, local_oksigeniaclasstools {{/str}}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.8" fill="none" stroke="currentColor" stroke-width="2"/><path class="ct-ch-tachado" d="M4 4l16 16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
            </div>
            {{/courses}}
            <p class="ct-ch-nada" id="ct-ch-nada" hidden>{{#str}} choose_none_found, local_oksigeniaclasstools {{/str}}</p>
            <button type="button" class="ct-ch-verocultos" id="ct-ch-verocultos" aria-pressed="false" data-show="{{#str}} choose_showhidden, local_oksigeniaclasstools {{/str}}" data-hide="{{#str}} choose_hidehidden, local_oksigeniaclasstools {{/str}}"{{^hiddencount}} hidden{{/hiddencount}}>{{#str}} choose_showhidden, local_oksigeniaclasstools {{/str}} ({{hiddencount}})</button>
        </div>
        <aside class="ct-ch-panel">
            {{#continue}}
            <a class="ct-ch-seguir" href="{{url}}">
                <img src="{{image}}" alt="" loading="lazy">
                <span><span class="ct-ch-ante">{{#str}} choose_continue, local_oksigeniaclasstools {{/str}}</span><strong>{{name}}</strong></span>
            </a>
            {{/continue}}
            {{#album}}
            <div class="ct-ch-logros" id="ct-ch-logros" data-album="{{json}}">
                <span class="ct-ch-ante">{{#str}} app_cr_album, local_oksigeniaclasstools {{/str}}</span>
                <strong class="ct-ch-logros-n">{{got}}</strong>
                {{#split}}<span class="ct-ch-nota ct-ch-logros-reparto">{{split}}</span>{{/split}}
                <div class="ct-ch-tira" id="ct-ch-tira"></div>
                <button type="button" class="ct-ch-boton" id="ct-ch-abrir">{{#str}} app_cr_open, local_oksigeniaclasstools {{/str}}</button>
            </div>
            {{/album}}
            {{#sala}}
            <div class="ct-ch-sala" id="ct-ch-sala" data-sala="{{json}}" data-ajax="{{ajax}}" data-sesskey="{{sesskey}}">
                <span class="ct-ch-ante">{{#str}} sala, local_oksigeniaclasstools {{/str}}</span>
                <strong class="ct-ch-logros-n">{{count}}</strong>
                <div class="ct-ch-sala-caras" id="ct-ch-sala-caras" aria-hidden="true"></div>
                <button type="button" class="ct-ch-boton" id="ct-ch-sala-abrir">{{#str}} sala_open, local_oksigeniaclasstools {{/str}}</button>
                <label class="ct-ch-sala-yo"><input type="checkbox" id="ct-ch-sala-yo"{{#joined}} checked{{/joined}}>
                    <span>{{#str}} sala_join, local_oksigeniaclasstools {{/str}}</span></label>
                <p class="ct-ch-nota">{{#str}} sala_join_note, local_oksigeniaclasstools {{/str}}</p>
            </div>
            {{/sala}}
            <a class="ct-ch-sin" href="{{standalone}}">
                <span class="ct-ch-icono" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 5h18v11H3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8 20h8M12 16v4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
                <span><strong>{{#str}} standalone, local_oksigeniaclasstools {{/str}}</strong><span class="ct-ch-nota">{{#str}} choose_standalone_desc, local_oksigeniaclasstools {{/str}}</span></span>
            </a>
            {{#remote}}
            <div class="ct-ch-mando">
                <span class="ct-ch-ante">{{#str}} choose_remote, local_oksigeniaclasstools {{/str}}</span>
                {{#on}}<div class="ct-ch-qr" id="ct-ch-qr" data-url="{{url}}"></div>
                <p class="ct-ch-nota">{{#str}} choose_remote_on, local_oksigeniaclasstools {{/str}}</p>{{/on}}
                {{^on}}<p class="ct-ch-nota">{{#str}} choose_remote_off, local_oksigeniaclasstools {{/str}}</p>{{/on}}
            </div>
            {{/remote}}
        </aside>
    </div>
    {{#album}}
    <dialog class="ct-ch-album" id="ct-ch-album" aria-labelledby="ct-ch-album-titulo">
        <div class="ct-ch-album-cab">
            <div>
                <h3 id="ct-ch-album-titulo">{{#str}} app_cr_album, local_oksigeniaclasstools {{/str}}</h3>
                <p class="ct-ch-nota">{{#str}} app_cr_intro, local_oksigeniaclasstools {{/str}}</p>
                <p class="ct-ch-semanas" id="ct-ch-semanas"></p>
            </div>
            <button type="button" class="ct-ch-cerrar" id="ct-ch-cerrar" aria-label="{{#str}} app_cr_close, local_oksigeniaclasstools {{/str}}">×</button>
        </div>
        <div class="ct-ch-album-rejilla" id="ct-ch-album-rejilla"></div>
    </dialog>
    {{/album}}
    {{#sala}}
    <dialog class="ct-ch-album ct-ch-sala-dialogo" id="ct-ch-sala-dialogo" aria-labelledby="ct-ch-sala-titulo">
        <div class="ct-ch-album-cab">
            <div>
                <h3 id="ct-ch-sala-titulo">{{#str}} sala, local_oksigeniaclasstools {{/str}}</h3>
                <p class="ct-ch-nota">{{#str}} sala_intro, local_oksigeniaclasstools {{/str}}</p>
                <p class="ct-ch-semanas">{{span}}</p>
            </div>
            <button type="button" class="ct-ch-cerrar" id="ct-ch-sala-cerrar" aria-label="{{#str}} sala_close, local_oksigeniaclasstools {{/str}}">×</button>
        </div>
        <ul class="ct-ch-sala-lista" id="ct-ch-sala-lista"></ul>
        {{#others}}<p class="ct-ch-sala-otros">{{others}}</p>{{/others}}
    </dialog>
    {{/sala}}
</div>
